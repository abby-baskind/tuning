# Operating-system and editor files
.DS_Store
.idea/
.vscode/
*~

# Python environments, caches, and test artifacts
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Jupyter's automatically generated notebook checkpoints
.ipynb_checkpoints/

# Notebooks are private by default. Public workflow notebooks must be named
# explicitly here so a scratch or data-heavy notebook cannot be pushed by
# accident. The first five entries are already in the public Git history.
*.ipynb
!CandidateParameterSets.ipynb
!CandidateParameterSetsBio.ipynb
!CandidateParameterSetsBio_MultiObjectiveTPE.ipynb
!CandidateParameterSetsPhysical.ipynb
!ParameterAnalysis.ipynb
!cost_function_v2.ipynb

# Local exploratory notebooks and backups retained outside version control.
scratch.ipynb
Optimization_Playground.ipynb
SurrogateModel.ipynb
*.original.ipynb

# Automated cost-function batch artifacts
#
# Each batch gets a timestamped directory containing its text logs, summary
# CSV, and temporary Papermill workspace. The batch script deletes executed
# notebooks, but ignoring the parent also protects against interrupted runs.
/batch_output/

# Retained Papermill/nbconvert outputs created manually outside batch_output.
# These patterns do not match the source notebook cost_function_v2.ipynb.
*.executed.ipynb
*_executed.ipynb

# Local databases and generated analysis products
*.db
*.sqlite
*.sqlite3
